# Copy to .env locally; configure these values in the hosting dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Enable only after configuring Google in Supabase Auth.
VITE_GOOGLE_AUTH_ENABLED=false
# Server only. Disabled by default: no AI requests or AI charges.
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Endpoint must implement OpenAI-compatible Chat Completions + structured output.
# Never prefix an AI key or service-role key with VITE_.
